BUDGET_CAL_DOMAIN=sunbeamgus.top
BUDGET_CAL_PUBLIC_ORIGIN=https://sunbeamgus.top
BUDGET_CAL_RP_ID=sunbeamgus.top
BUDGET_CAL_REGISTRATION_TOKEN=replace-with-a-long-random-token
BUDGET_CAL_DATA_DIR=/var/lib/budget-cal
BUDGET_CAL_DATABASE_URL=mysql://budgetcal:replace-password@127.0.0.1/budget_cal
BUDGET_CAL_MASTER_KEY_FILE=/etc/budget-cal/master.key
BUDGET_CAL_ALLOWED_ORIGINS=https://sunbeamgus.top,https://www.sunbeamgus.top
